# Django
SECRET_KEY=your-secret-key-here-generate-with-django-secret-key-generator
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite par défaut, pour PostgreSQL décommentez ci-dessous)
# DATABASE_URL=postgres://user:password@localhost:5432/dbname

# Email (console par défaut)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=ENAA <noreply@enaa.rdc>

# Media/Static (pour production avec whitenoise)
# STATIC_ROOT=/var/www/yourproject/static/
# MEDIA_ROOT=/var/www/yourproject/media/